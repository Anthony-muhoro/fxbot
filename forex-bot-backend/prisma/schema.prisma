datasource db {
  provider = "postgresql"
  
}

generator client {
  provider = "prisma-client-js"
}

enum OrderSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum BrokerProvider {
  OANDA
  ALPACA
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  brokerAccounts BrokerAccount[]
  strategies     Strategy[]
  trades         Trade[]

  @@map("users")
}

model BrokerAccount {
  id           String         @id @default(uuid())
  userId       String
  provider     BrokerProvider
  accountId    String         @unique
  encryptedKey String         
  isLive       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("broker_accounts")
}

model Strategy {
  id           String   @id @default(uuid())
  userId       String
  name         String
  isActive     Boolean  @default(false)
  parameters   Json     
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades       Trade[]

  @@map("strategies")
}

model Trade {
  id              String      @id @default(uuid())
  userId          String
  strategyId      String?
  brokerOrderId   String      @unique
  symbol          String      
  side            OrderSide
  units           Decimal     @db.Decimal(12, 4)
  entryPrice      Decimal     @db.Decimal(10, 5)
  exitPrice       Decimal?    @db.Decimal(10, 5)
  takeProfit      Decimal?    @db.Decimal(10, 5)
  stopLoss        Decimal?    @db.Decimal(10, 5)
  status          TradeStatus @default(OPEN)
  pnl             Decimal?    @db.Decimal(12, 4)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy        Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([symbol, status])
  @@index([userId, openedAt])
  @@map("trades")
}